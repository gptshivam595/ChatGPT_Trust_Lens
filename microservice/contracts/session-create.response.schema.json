{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trust-lens.local/contracts/session-create.response.schema.json",
  "title": "Create Trust Lens Session Response",
  "type": "object",
  "required": ["data", "meta"],
  "properties": {
    "data": {
      "type": "object",
      "required": ["sessionId", "createdAt"],
      "properties": {
        "sessionId": { "type": "string", "minLength": 1 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    },
    "meta": { "$ref": "common.schema.json#/$defs/Meta" }
  },
  "additionalProperties": false
}

{
  "name": "trust-lens-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Trust Lens Phase 3 Fastify backend skeleton with deterministic mock API responses.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json && node scripts/copy-contracts.mjs",
    "start": "node dist/server.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^13.0.1",
    "@fastify/rate-limit": "^10.2.2",
    "@types/node": "^22.10.5",
    "fastify": "^5.2.0",
    "typescript": "^5.7.2"
  },
  "devDependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "tsx": "^4.19.2",
    "vitest": "^4.1.8"
  }
}
